{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
  },
  "ApiSettings": {
    "JwtOptions": {
      "Secret": "YOUR_SECRET_KEY_HERE",
      "Issuer": "application-auth-api",
      "Audience": "application-client"
    }
  }
}